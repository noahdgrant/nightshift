{
  "disableAllHooks": false,
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(terraform apply:*)",
      "Read(//**/.env)",
      "Read(//**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{ns} guard-hooks || exit 2"
          }
        ]
      }
    ]
  }
}
