#!/bin/bash
# Fake gh for ns run / ns watch tests. Serves canned JSON from $FAKE_GH_DIR and records calls.
d="$FAKE_GH_DIR"
printf '%s\n' "$*" >> "$d/calls"
printf '%s\n' "${GH_TOKEN:-}" >> "$d/tokens"
printf '%s\n' "${GH_HOST:-}" >> "$d/hosts"
# hook.sh, when it exists, is sourced first with gh's arguments: a test's way to act mid-run.
[ -f "$d/hook.sh" ] && . "$d/hook.sh"
case "$1 $2" in
  "api --paginate")
    # Each issue is listed with its current labels from labels-<n> when that file exists, so an
    # issues.jsonl line needs a matching labels-<n> (the Env helpers write both). A `labels=`
    # query lists an issue that carries the label now, or that carried it when filed and is not
    # in taken.
    want=$(printf '%s' "$3" | sed -n 's/.*[?&]labels=\([^&]*\).*/\1/p')
    while read -r line; do
      [ -z "$line" ] && continue
      n=$(printf '%s' "$line" | sed -n 's/.*"number": *\([0-9]*\).*/\1/p')
      if [ -n "$want" ] && ! grep -qxF -- "$want" "$d/labels-$n" 2>/dev/null; then
        grep -qx "$n" "$d/taken" 2>/dev/null && continue
        [[ "$line" == *"{\"name\":\"$want\"}"* ]] || continue
      fi
      if [ -f "$d/labels-$n" ]; then
        cur=$(sep=; while read -r l; do printf '%s{"name":"%s"}' "$sep" "$l"; sep=,; done < "$d/labels-$n")
        line=$(printf '%s' "$line" | sed "s/\"labels\":\[[^]]*\]/\"labels\":[$cur]/")
      fi
      printf '%s\n' "$line"
    done < "$d/issues.jsonl"
    ;;
  "api repos/"*/check-runs)
    if [ -f "$d/check-runs.fail" ]; then cat "$d/check-runs.fail" >&2; exit 1; fi
    if [ -f "$d/check-runs.output" ]; then cat "$d/check-runs.output"; exit 0; fi
    c=$(( $(cat "$d/register.count" 2>/dev/null || echo 0) + 1 ))
    echo $c > "$d/register.count"
    [ "$c" -gt "$(cat "$d/register.after" 2>/dev/null || echo 0)" ] && echo 1 || echo 0
    ;;
  "api graphql")
    # main-ci.json: the answer to ns watch's query for main's CI; unset, a head with no CI.
    if [ -f "$d/main-ci.fail" ]; then cat "$d/main-ci.fail" >&2; exit 1; fi
    cat "$d/main-ci.json" 2>/dev/null || printf '{"data":{"repository":{"defaultBranchRef":{"rules":{"nodes":[]},"target":{"oid":"%s","statusCheckRollup":null}}}}}\n' "$(git rev-parse HEAD 2>/dev/null)"
    ;;
  "api repos/"*/pulls)
    # pulls-<sha>.json: the PRs GitHub links to commit <sha>; pulls.fail makes the query fail.
    if [ -f "$d/pulls.fail" ]; then echo "HTTP 502" >&2; exit 1; fi
    sha=${2%/pulls}; sha=${sha##*/}
    cat "$d/pulls-$sha.json" 2>/dev/null || echo "[]"
    ;;
  "api repos/"*/status)
    if [ -f "$d/status.fail" ]; then cat "$d/status.fail" >&2; exit 1; fi
    c=$(( $(cat "$d/status.count" 2>/dev/null || echo 0) + 1 ))
    echo $c > "$d/status.count"
    [ -f "$d/status.after" ] && [ "$c" -gt "$(cat "$d/status.after")" ] && echo 1 || echo 0
    ;;
  "api repos/"*)
    # repo.fail: the token can't read the repo, with the file's text as gh's error.
    if [ -f "$d/repo.fail" ]; then cat "$d/repo.fail" >&2; exit 1; fi
    echo "${2#repos/}"
    ;;
  "api user")
    # login: the account the token belongs to; unset, the call fails.
    cat "$d/login" 2>/dev/null || { echo "HTTP 401" >&2; exit 1; }
    ;;
  "issue view")
    if [[ " $* " == *" --json labels "* ]]; then
      [ -f "$d/labels-$3.fail" ] && { echo "HTTP 502" >&2; exit 1; }
      touch "$d/labels-$3"
      sep=""; printf '{"labels":['
      while read -r l; do printf '%s{"name":"%s"}' "$sep" "$l"; sep=,; done < "$d/labels-$3"
      printf ']}\n'
      exit 0
    fi
    cat "$d/issue-$3.json" 2>/dev/null || { echo "no issue $3" >&2; exit 1; }
    ;;
  "issue edit")
    f="$d/labels-$3"; touch "$f"; a=("$@")
    drop=; [ -f "$d/edit.noop" ] && drop=1
    [ -f "$d/edit.drop-once" ] && { rm "$d/edit.drop-once"; drop=1; }
    for ((i = 3; i < ${#a[@]}; i++)); do
      [ -n "$drop" ] && break
      l=${a[$((i + 1))]}
      case "${a[$i]}" in
        --remove-label) grep -vxF -- "$l" "$f" > "$f.tmp" || true; mv "$f.tmp" "$f" ;;
        --add-label) grep -qxF -- "$l" "$f" || echo "$l" >> "$f" ;;
      esac
    done
    # ready-sticks: GitHub still lists the issue as ready, as it does until the closing PR lands.
    if [[ " $* " == *" --remove-label status:ready-for-agent "* ]] && [ ! -f "$d/ready-sticks" ]; then echo "$3" >> "$d/taken"; fi
    if [[ " $* " == *" --add-label status:ready-for-agent "* ]] && [ -f "$d/taken" ]; then sed -i "/^$3\$/d" "$d/taken"; fi
    ;;
  "issue create")
    # Files issue next-issue (default 100), team-authored, listed open with its labels; its body
    # goes to created-<n>.body. create.fail makes it fail; create.unlisted keeps it off the list,
    # as GitHub may for a moment.
    [ -f "$d/create.fail" ] && { echo "HTTP 502" >&2; exit 1; }
    n=$(cat "$d/next-issue" 2>/dev/null || echo 100); echo $((n + 1)) > "$d/next-issue"
    a=("$@"); : > "$d/labels-$n"
    for ((i = 2; i < ${#a[@]}; i++)); do
      case "${a[$i]}" in
        --title) title=${a[$((i + 1))]} ;;
        --body) printf '%s' "${a[$((i + 1))]}" > "$d/created-$n.body" ;;
        --label) echo "${a[$((i + 1))]}" >> "$d/labels-$n" ;;
      esac
    done
    printf '{"number":%s,"title":"%s","url":"u","state":"OPEN"}\n' "$n" "$title" > "$d/issue-$n.json"
    [ -f "$d/create.unlisted" ] || printf '{"number":%s,"title":"%s","labels":[],"body":"","authorAssociation":"OWNER"}\n' "$n" "$title" >> "$d/issues.jsonl"
    echo "https://github.com/o/r/issues/$n"
    ;;
  "issue comment") ;;
  "issue close") [ -f "$d/close.fail" ] && { echo "issue #$3 is already closed" >&2; exit 1; } ;;
  "pr list")
    f=prs.json; [[ " $* " == *" --state merged "* ]] && f=prs-merged.json
    cat "$d/$f" 2>/dev/null || echo "[]"
    ;;
  "label create")
    # label.exists: the label is already there; label.fail: GitHub refuses with the file's text.
    [ -f "$d/label.exists" ] && { echo "label with name \"$3\" already exists; use \`--force\` to update its color and description" >&2; exit 1; }
    if [ -f "$d/label.fail" ]; then cat "$d/label.fail" >&2; exit 1; fi
    ;;
  "pr edit")
    f="$d/pr-labels-$3"; touch "$f"; a=("$@")
    for ((i = 3; i < ${#a[@]}; i++)); do
      l=${a[$((i + 1))]}
      case "${a[$i]}" in
        --remove-label) grep -vxF -- "$l" "$f" > "$f.tmp" || true; mv "$f.tmp" "$f" ;;
        --add-label) grep -qxF -- "$l" "$f" || echo "$l" >> "$f" ;;
      esac
    done
    ;;
  "pr comment") ;;
  "pr view")
    if [[ " $* " == *" --json labels "* ]]; then
      sep=""; printf '{"labels":['
      while read -r l; do printf '%s{"name":"%s"}' "$sep" "$l"; sep=,; done < <(cat "$d/pr-labels-$3" 2>/dev/null)
      printf ']}\n'
      exit 0
    fi
    # updated-<n>.lag: how many views after update-branch still report the old head.
    if [ -f "$d/lag-$3" ]; then
      left=$(cat "$d/lag-$3")
      if [ "$left" -le 0 ]; then mv "$d/pending-$3.head" "$d/pr-$3.head"; rm "$d/lag-$3"
      else echo $((left - 1)) > "$d/lag-$3"; fi
    fi
    st=$(cat "$d/pr-$3.state" 2>/dev/null || echo OPEN)
    ms=$(cat "$d/pr-$3.merge" 2>/dev/null || echo CLEAN)
    hd=$(cat "$d/pr-$3.head" 2>/dev/null || git rev-parse HEAD 2>/dev/null)
    oid="\"$hd\""; [ "$hd" = none ] && oid=null
    # pr-<n>.body: the PR body (no quotes or backslashes); pr-<n>.ref: its head branch, else the
    # branch checked out where gh runs.
    body=$(cat "$d/pr-$3.body" 2>/dev/null)
    ref=$(cat "$d/pr-$3.ref" 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null)
    printf '{"state":"%s","headRefOid":%s,"mergeStateStatus":"%s","body":"%s","headRefName":"%s"}\n' "$st" "$oid" "$ms" "$body" "$ref"
    ;;
  "pr checks")
    [[ " $* " == *" --watch "* ]] && exit 0
    c=$(( $(cat "$d/checks-$3.count" 2>/dev/null || echo 0) + 1 ))
    echo $c > "$d/checks-$3.count"
    cat "$d/checks-$3-$c.json" 2>/dev/null || cat "$d/checks-$3.json" 2>/dev/null || echo "[]"
    ;;
  "pr diff") cat "$d/diff-$3.txt" 2>/dev/null || true ;;
  "pr update-branch")
    # update-<n>.fail: update-branch fails with the file's text, else "conflict".
    if [ -f "$d/update-$3.fail" ]; then
      if [ -s "$d/update-$3.fail" ]; then cat "$d/update-$3.fail" >&2; else echo conflict >&2; fi
      exit 1
    fi
    cat "$d/updated-$3.merge" 2>/dev/null > "$d/pr-$3.merge" || echo CLEAN > "$d/pr-$3.merge"
    cat "$d/updated-$3.head" 2>/dev/null > "$d/pending-$3.head" \
      || echo 00000000000000000000000000000000000000aa > "$d/pending-$3.head"
    cat "$d/updated-$3.lag" 2>/dev/null > "$d/lag-$3" || echo 0 > "$d/lag-$3"
    ;;
  "pr merge") echo MERGED > "$d/pr-$3.state" ;;
  "run view") echo "FAILED tests/test_x.py::test_y - assert 1 == 2" ;;
  "repo view") cat "$d/repo-view.json" 2>/dev/null || echo '{"defaultBranchRef":{"name":"main"}}' ;;
  "run list") cat "$d/runs-green.json" 2>/dev/null || echo "[]" ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
