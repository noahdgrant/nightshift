#!/bin/bash
# Fake gh for ns run / ns watch tests. Serves canned JSON from $FAKE_GH_DIR and records calls.
d="$FAKE_GH_DIR"
printf '%s\n' "$*" >> "$d/calls"
printf '%s\n' "${GH_TOKEN:-}" >> "$d/tokens"
printf '%s\n' "${GH_HOST:-}" >> "$d/hosts"
case "$1 $2" in
  "api --paginate")
    while read -r line; do
      [ -z "$line" ] && continue
      n=$(printf '%s' "$line" | sed -n 's/.*"number": *\([0-9]*\).*/\1/p')
      grep -qx "$n" "$d/taken" 2>/dev/null && continue
      printf '%s\n' "$line"
    done < "$d/issues.jsonl"
    ;;
  "api repos/"*/check-runs)
    if [ -f "$d/check-runs.fail" ]; then cat "$d/check-runs.fail" >&2; exit 1; fi
    if [ -f "$d/check-runs.output" ]; then cat "$d/check-runs.output"; exit 0; fi
    c=$(( $(cat "$d/register.count" 2>/dev/null || echo 0) + 1 ))
    echo $c > "$d/register.count"
    [ "$c" -gt "$(cat "$d/register.after" 2>/dev/null || echo 0)" ] && echo 1 || echo 0
    ;;
  "api repos/"*/status)
    if [ -f "$d/status.fail" ]; then cat "$d/status.fail" >&2; exit 1; fi
    c=$(( $(cat "$d/status.count" 2>/dev/null || echo 0) + 1 ))
    echo $c > "$d/status.count"
    [ -f "$d/status.after" ] && [ "$c" -gt "$(cat "$d/status.after")" ] && echo 1 || echo 0
    ;;
  "issue view")
    if [[ " $* " == *" --json labels "* ]]; then
      touch "$d/labels-$3"
      sep=""; printf '{"labels":['
      while read -r l; do printf '%s{"name":"%s"}' "$sep" "$l"; sep=,; done < "$d/labels-$3"
      printf ']}\n'
      exit 0
    fi
    cat "$d/issue-$3.json" 2>/dev/null || { echo "no issue $3" >&2; exit 1; }
    ;;
  "issue edit")
    # labels-N holds the issue's labels; edit.noop makes every edit silently not land.
    f="$d/labels-$3"; touch "$f"; a=("$@")
    for ((i = 3; i < ${#a[@]}; i++)); do
      [ -f "$d/edit.noop" ] && break
      l=${a[$((i + 1))]}
      case "${a[$i]}" in
        --remove-label) grep -vxF -- "$l" "$f" > "$f.tmp" || true; mv "$f.tmp" "$f" ;;
        --add-label) grep -qxF -- "$l" "$f" || echo "$l" >> "$f" ;;
      esac
    done
    # ready-sticks: GitHub still lists the issue as ready, as it does until the closing PR lands.
    if [[ " $* " == *" --remove-label status:ready-for-agent "* ]] && [ ! -f "$d/ready-sticks" ]; then echo "$3" >> "$d/taken"; fi
    if [[ " $* " == *" --add-label status:ready-for-agent "* ]]; then sed -i "/^$3\$/d" "$d/taken"; fi
    ;;
  "issue comment") ;;
  "issue close") [ -f "$d/close.fail" ] && { echo "issue #$3 is already closed" >&2; exit 1; } ;;
  "pr list")
    f=prs.json; [[ " $* " == *" --state merged "* ]] && f=prs-merged.json
    cat "$d/$f" 2>/dev/null || echo "[]"
    ;;
  "pr view")
    st=$(cat "$d/pr-$3.state" 2>/dev/null || echo OPEN)
    ms=$(cat "$d/pr-$3.merge" 2>/dev/null || echo CLEAN)
    hd=$(cat "$d/pr-$3.head" 2>/dev/null || git rev-parse HEAD 2>/dev/null)
    oid="\"$hd\""; [ "$hd" = none ] && oid=null
    printf '{"state":"%s","headRefOid":%s,"mergeStateStatus":"%s"}\n' "$st" "$oid" "$ms"
    ;;
  "pr checks")
    [[ " $* " == *" --watch "* ]] && exit 0
    c=$(( $(cat "$d/checks-$3.count" 2>/dev/null || echo 0) + 1 ))
    echo $c > "$d/checks-$3.count"
    cat "$d/checks-$3-$c.json" 2>/dev/null || cat "$d/checks-$3.json" 2>/dev/null || echo "[]"
    ;;
  "pr diff") cat "$d/diff-$3.txt" 2>/dev/null || true ;;
  "pr update-branch")
    [ -f "$d/update-$3.fail" ] && { echo "conflict" >&2; exit 1; }
    echo CLEAN > "$d/pr-$3.merge"
    [ -f "$d/updated-$3.head" ] && cp "$d/updated-$3.head" "$d/pr-$3.head"
    ;;
  "pr merge") echo MERGED > "$d/pr-$3.state" ;;
  "run view") echo "FAILED tests/test_x.py::test_y - assert 1 == 2" ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
