#!/bin/bash
# Fake harness for ns run tests. Reads the phase from the prompt, pops the next action from
# $FAKE_CTRL/<phase> (default: pass) and writes that phase's artifact.
#   action = status[:extra]; status: pass | fail | blocked | none | limit | session | crash
#   extra:   commit | push | merge | script | any text (lands in the body, e.g. "review")
#   commit and push append to work.txt, or run $FAKE_CTRL/edit instead when it exists
#   script runs $FAKE_CTRL/<phase>.sh in the worktree
#   <extra>+sleep (e.g. commit+sleep) does the extra, then sleeps
#   $FAKE_CTRL/<phase>.body, when it exists, is appended to the artifact body
#   ship's pr.md names PR $FAKE_CTRL/pr-$NS_UNIT, else $FAKE_CTRL/pr, else none
#   sleep writes the artifact last, then execs sleep so a short timeout kills it with no orphan
set -e
ctrl="$FAKE_CTRL"
prompt=$(cat)
phase=$(printf '%s\n' "$prompt" | sed -n 's/^Phase: \([a-z]*\).*/\1/p' | head -1)
echo "$phase" >> "$ctrl/calls"
n=$(wc -l < "$ctrl/calls" | tr -d ' ')
printf '%s' "$prompt" > "$ctrl/prompt-$n-$phase.txt"
echo "$*" > "$ctrl/args"
printf '%s\n' "${GH_TOKEN:-}" >> "$ctrl/tokens"
printf '%s %s\n' "${GITLAB_TOKEN:-}" "${GITLAB_HOST:-}" >> "$ctrl/gitlab"
printf '%s\n' "${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS-unset}" >> "$ctrl/bgwait"
printf '%s\n' "${CLAUDE_CODE_DISABLE_AUTO_MEMORY-unset}" >> "$ctrl/automem"
[ -n "${ANTHROPIC_API_KEY:-}" ] && echo "ANTHROPIC_API_KEY" >> "$ctrl/leak"
action=pass
if [ -s "$ctrl/$phase" ]; then
  action=$(head -1 "$ctrl/$phase")
  sed -i 1d "$ctrl/$phase"
fi
status=${action%%:*}
extra=""
[ "$status" != "$action" ] && extra=${action#*:}
if [ "$status" = session ]; then
  # The shape claude -p emits for a subscription session limit: structured fields, no "usage limit" text.
  printf '{"type":"assistant","error":"rate_limit","api_error_params":{"rate_limit_info":{"status":"rejected","resetsAt":%s}}}\n' "$(cat "$ctrl/reset")"
  printf '{"type":"result","subtype":"success","is_error":true,"api_error_status":429,"api_error":"usage_limit_reached","result":"You have hit your session limit - resets 3am"}\n'
  exit 1
fi
if [ "$status" = crash ]; then
  exit 1
fi
if [ "$status" = limit ]; then
  printf '{"type":"result","is_error":true,"result":"Claude AI usage limit reached|%s"}\n' "$(cat "$ctrl/reset")"
  exit 1
fi
case $phase in
  triage) art=brief ;; build) art=build ;; verify) art=evidence ;; review) art=review ;; ship) art=pr ;;
esac
sleepy=0
case "$extra" in *+sleep) sleepy=1; extra=${extra%+sleep} ;; esac
dir=".ns/$NS_UNIT"
mkdir -p "$dir"
case "$extra" in
  commit|push)
    if [ -f "$ctrl/edit" ]; then sh "$ctrl/edit"; else echo "$phase $n" >> work.txt; fi
    git add work.txt
    git -c user.name=f -c user.email=f@f commit -qm "$phase $n"
    ;;
esac
[ "$extra" = script ] && sh "$ctrl/$phase.sh"
[ "$extra" = push ] && git push -q origin HEAD:main
[ "$extra" = merge ] && echo MERGED > "$FAKE_GH_DIR/pr-$(cat "$ctrl/pr").state"
echo '{"type":"result","is_error":false,"result":"ok","total_cost_usd":0.5,"usage":{"input_tokens":10,"output_tokens":5}}'
[ "$status" = none ] && exit 0
sha=$(git rev-parse --short HEAD)
{
  echo ---
  echo "unit: $NS_UNIT"
  echo "phase: $phase"
  echo "status: $status"
  echo "sha: $sha"
  prf="$ctrl/pr"; [ -s "$ctrl/pr-$NS_UNIT" ] && prf="$ctrl/pr-$NS_UNIT"
  if [ "$art" = pr ] && [ -s "$prf" ]; then echo "pr: https://github.com/o/r/pull/$(cat "$prf")"; fi
  echo "updated: 2026-10-08T00:00:00Z"
  echo ---
  echo "$phase said $status $extra"
  [ -f "$ctrl/$phase.body" ] && cat "$ctrl/$phase.body"
} > "$dir/$art.md"
if [ "$extra" = sleep ] || [ "$sleepy" = 1 ]; then exec sleep 30; fi
