#!/bin/bash
# Fake glab for ns watch tests on a GitLab project. Serves canned JSON from $FAKE_GH_DIR, sharing
# labels-<n> with the fake gh, and records calls in glab-calls.
#   gl-issues.jsonl  one open issue per line: {"iid","title","labels","description","author"}
#   gl-members.json  the project's members/all list
#   gl-mrs.json, gl-mrs-merged.json  open and merged merge requests
#   gl-state-<n>     an issue's state, default opened
#   gl-issue-<n>.raw what reading issue <n> prints instead
#   gl-statuses.json the commit statuses on main's head, default none
#   gl-project.json, gl-branch.json  what reading the project or main's branch prints instead
#   gl-pipelines-green.json  the newest successful pipeline on main, default none
#   a POST to projects/:id/issues files issue next-issue (default 100) by member 1; its
#   description goes to created-<n>.body; gl-create.raw is what it prints instead
#   glab.fail        every call fails, echoing GITLAB_TOKEN on stderr as a leaky server might
d="$FAKE_GH_DIR"
printf '%s\n' "$*" >> "$d/glab-calls"
[ -f "$d/glab.fail" ] && { echo "401 Unauthorized: token ${GITLAB_TOKEN:-}" >&2; exit 1; }
labels_of() {
  sep=; while read -r l; do printf '%s"%s"' "$sep" "$l"; sep=,; done < "$d/labels-$1"
}
case "$1 $2" in
  "api --paginate"|"api projects/"*)
    [ "$2" = --paginate ] && shift
    path=$2
    case "$path" in
      "projects/:id/issues?"*)
        want=$(printf '%s' "$path" | sed -n 's/.*[?&]labels=\([^&]*\).*/\1/p')
        want=$(printf '%b' "$(printf '%s' "$want" | sed 's/%/\\x/g')")
        # One array per issue: pages arrive as JSON arrays one after another.
        while read -r line; do
          [ -z "$line" ] && continue
          n=$(printf '%s' "$line" | sed -n 's/.*"iid": *\([0-9]*\).*/\1/p')
          touch "$d/labels-$n"
          [ -n "$want" ] && ! grep -qxF -- "$want" "$d/labels-$n" && continue
          ls=$(labels_of "$n"); ls=${ls//&/\\&}
          line=$(printf '%s' "$line" | sed "s/\"labels\":\[[^]]*\]/\"labels\":[$ls]/")
          printf '[%s]\n' "$line"
        done < "$d/gl-issues.jsonl"
        ;;
      "projects/:id/issues/"*)
        n=${path##*/}; touch "$d/labels-$n"
        [ -f "$d/gl-issue-$n.raw" ] && { cat "$d/gl-issue-$n.raw"; exit 0; }
        printf '{"iid":%s,"state":"%s","labels":[%s]}\n' "$n" \
          "$(cat "$d/gl-state-$n" 2>/dev/null || echo opened)" "$(labels_of "$n")"
        ;;
      "projects/:id") cat "$d/gl-project.json" 2>/dev/null || echo '{"default_branch":"main"}' ;;
      "projects/:id/repository/branches/"*)
        cat "$d/gl-branch.json" 2>/dev/null || printf '{"commit":{"id":"%s"}}\n' "$(git rev-parse HEAD)" ;;
      "projects/:id/repository/commits/"*/statuses*) cat "$d/gl-statuses.json" 2>/dev/null || echo "[]" ;;
      "projects/:id/pipelines?"*) cat "$d/gl-pipelines-green.json" 2>/dev/null || echo "[]" ;;
      "projects/:id/jobs/"*/trace) echo "ERROR: Job failed: assert 1 == 2" ;;
      "projects/:id/members/all"*) cat "$d/gl-members.json" 2>/dev/null || echo "[]" ;;
      "projects/:id/merge_requests?state=opened"*) cat "$d/gl-mrs.json" 2>/dev/null || echo "[]" ;;
      "projects/:id/merge_requests?state=merged"*) cat "$d/gl-mrs-merged.json" 2>/dev/null || echo "[]" ;;
      *) echo "fake glab: unsupported api path: $path" >&2; exit 1 ;;
    esac
    ;;
  "api --method")
    [ "$3 $4" = "POST projects/:id/issues" ] || { echo "fake glab: unsupported: $*" >&2; exit 1; }
    [ -f "$d/gl-create.raw" ] && { cat "$d/gl-create.raw"; exit 0; }
    n=$(cat "$d/next-issue" 2>/dev/null || echo 100); echo $((n + 1)) > "$d/next-issue"
    a=("$@"); title=; labels=
    for ((i = 4; i < ${#a[@]}; i++)); do
      [ "${a[$i]}" = --raw-field ] || continue
      f=${a[$((i + 1))]}
      case "$f" in
        title=*) title=${f#title=} ;;
        description=*) printf '%s' "${f#description=}" > "$d/created-$n.body" ;;
        labels=*) labels=${f#labels=} ;;
      esac
    done
    printf '%s\n' ${labels//,/ } > "$d/labels-$n"
    printf '{"iid":%s,"title":"%s","labels":[],"description":"","author":{"id":1,"username":"u1"}}\n' "$n" "$title" >> "$d/gl-issues.jsonl"
    printf '{"number":%s,"title":"%s","url":"u","state":"OPEN"}\n' "$n" "$title" > "$d/issue-$n.json"
    printf '{"iid":%s}\n' "$n"
    ;;
  "issue update")
    f="$d/labels-$3"; touch "$f"; a=("$@")
    for ((i = 3; i < ${#a[@]}; i++)); do
      l=${a[$((i + 1))]}
      case "${a[$i]}" in
        --unlabel) grep -vxF -- "$l" "$f" > "$f.tmp" || true; mv "$f.tmp" "$f" ;;
        --label) grep -qxF -- "$l" "$f" || echo "$l" >> "$f" ;;
      esac
    done
    ;;
  "issue note") ;;
  "issue close") echo closed > "$d/gl-state-$3" ;;
  *) echo "fake glab: unsupported: $*" >&2; exit 1 ;;
esac
