#!/bin/sh
# Fake cargo for ns watch's self-update. `cargo build ... --manifest-path M --target-dir T` logs
# its arguments to $FAKE_CTRL/cargo-calls, copies M's directory's x to $FAKE_CTRL/cargo-built,
# and writes a stub ns to T/release/ns. The stub prints the version with $NS_BUILD_COMMIT, exits
# 0 on `watch --dry-run`, runs a unit's `run ...` as $REAL_NS, logging its arguments to
# $FAKE_CTRL/stub-runs, and otherwise logs its arguments to $FAKE_CTRL/handed-off and its own
# path to $FAKE_CTRL/staged, then execs $REAL_NS with them minus any --until, plus
# --no-self-update: a new ns that does not read the deadline again.
#   $FAKE_CTRL/cargo-mode: fail (the build fails), badcheck (the stub's dry run exits 1) or
#   badversion (the stub's version names another commit), versionfails (it exits 1), slow (the
#   build writes $FAKE_CTRL/cargo-started and hangs), stopped (the build sends ns SIGTERM and
#   succeeds) or unexecutable (the stub's dry run passes, then it makes itself unexecutable, so
#   the exec fails) or held (the build writes $FAKE_CTRL/cargo-started, then waits for a line on
#   the fifo $FAKE_CTRL/cargo-go before it builds). When the fifo $FAKE_CTRL/dry-entered exists,
#   the stub's dry run writes a line to it, then waits for one on $FAKE_CTRL/dry-go
ctrl="$FAKE_CTRL"
echo "$*" >> "$ctrl/cargo-calls"
mode=$(cat "$ctrl/cargo-mode" 2>/dev/null)
if [ "$mode" = fail ]; then
  echo "error: could not compile nightshift" >&2
  exit 101
fi
if [ "$mode" = slow ]; then
  touch "$ctrl/cargo-started"
  sleep 60
  exit 0
fi
[ "$mode" = stopped ] && kill -TERM "$PPID"
if [ "$mode" = held ]; then
  touch "$ctrl/cargo-started"
  cat "$ctrl/cargo-go" > /dev/null
fi
while [ $# -gt 0 ]; do
  case "$1" in
    --manifest-path) m=$2; shift ;;
    --target-dir) t=$2; shift ;;
  esac
  shift
done
cat "$(dirname "$m")/x" > "$ctrl/cargo-built"
dry=0
[ "$mode" = badcheck ] && dry=1
commit=$NS_BUILD_COMMIT
[ "$mode" = badversion ] && commit=0000000
version_exit=0
after_dry=:
[ "$mode" = unexecutable ] && after_dry='chmod -x "$0"'
[ "$mode" = versionfails ] && version_exit=1
mkdir -p "$t/release"
cat > "$t/release/ns" <<STUB
#!/bin/sh
if [ "\$1" = --version ]; then echo "ns 0.1.0 ($commit)"; exit $version_exit; fi
if [ "\$1" = run ]; then echo "\$*" >> "$ctrl/stub-runs"; exec "\$REAL_NS" "\$@"; fi
case " \$* " in *" --dry-run "*) is_dry=1 ;; *) is_dry=0 ;; esac
if [ \$is_dry = 1 ] && [ -p "$ctrl/dry-entered" ]; then echo in > "$ctrl/dry-entered"; cat "$ctrl/dry-go" > /dev/null; fi
if [ \$is_dry = 1 ]; then echo "\$*" > "$ctrl/dry-run-args"; echo "dry run failed" >&2; $after_dry; exit $dry; fi
echo "\$*" > "$ctrl/handed-off"
echo "\$0" > "$ctrl/staged"
n=\$#
skip=0
while [ \$n -gt 0 ]; do
  a=\$1; shift; n=\$((n - 1))
  if [ \$skip = 1 ]; then skip=0; continue; fi
  if [ "\$a" = --until ]; then skip=1; continue; fi
  set -- "\$@" "\$a"
done
exec "\$REAL_NS" "\$@" --no-self-update
STUB
chmod +x "$t/release/ns"
