#!/usr/bin/env bash
# Fake systemd-run for ns eval: records the call, marks the unit active, and runs nothing.
fake=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/fake
[ "$fake" = /fake ] && fake=$HOME/fake
mkdir -p "$fake/active"
echo "systemd-run $*" >> "$fake/calls.log"
unit=run-u1.service
while [ $# -gt 0 ]; do
  case $1 in
    --unit=*) unit=${1#*=} ;;
    -u|--unit) unit=$2; shift ;;
  esac
  shift
done
case $unit in *.*) ;; *) unit=$unit.service ;; esac
date -u '+%a %Y-%m-%d %H:%M:%S UTC' > "$fake/active/$unit"
echo "Running as unit: $unit"
