+use shop::{db::Db, orders};
+
+#[test]
+fn post_orders_stores_the_order() {
+    let db = Db::in_memory();
+    assert_eq!(orders::create(&db, "tea").unwrap(), 1);
+    assert_eq!(db.count("orders"), 1);
+}
