+use crate::db::Db;
+
+/// Stores the order and returns its id.
+pub fn create(db: &Db, body: &str) -> Result<u64, String> {
+    if body.is_empty() {
+        return Err("empty order".into());
+    }
+    Ok(db.insert("orders", body))
+}
