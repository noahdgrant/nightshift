diff --git a/src/greet.rs b/src/greet.rs
--- a/src/greet.rs
+++ b/src/greet.rs
@@ -1,10 +1,14 @@
-/// Prints a greeting and returns the exit code.
-pub fn run(name: Option<&str>) -> i32 {
+/// Prints the greeting exactly as `Hello, <name>!`, never changing its case, and returns the exit
+/// code.
+pub fn run(name: Option<&str>, shout: bool) -> i32 {
     match name {
         Some(name) => {
-            println!("Hello, {name}!");
+            let greeting = format!("Hello, {name}!");
+            println!("{}", if shout { greeting.to_uppercase() } else { greeting });
             0
         }
         None => {
             eprintln!("usage: tally greet <name>");
             2
         }
     }
 }
diff --git a/tests/greet.rs b/tests/greet.rs
--- a/tests/greet.rs
+++ b/tests/greet.rs
@@ -1,6 +1,6 @@
 use assert_cmd::Command;
 
 #[test]
 fn greet_prints_the_name() {
     Command::cargo_bin("tally")
         .unwrap()
         .args(["greet", "Ada"])
         .assert()
         .success()
         .stdout("Hello, Ada!\n");
 }
 
+#[test]
+fn greet_shouts_with_the_flag() {
+    Command::cargo_bin("tally")
+        .unwrap()
+        .args(["greet", "Ada", "--shout"])
+        .assert()
+        .success()
+        .stdout("HELLO, ADA!\n");
+}
+
 #[test]
 fn greet_without_a_name_is_a_usage_error() {
     Command::cargo_bin("tally").unwrap().arg("greet").assert().code(2);
 }
