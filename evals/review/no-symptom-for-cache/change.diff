+++ b/tests/products.rs
@@ -0,0 +1,12 @@
+use shop::{db::Db, products};
+
+#[test]
+fn get_product_returns_it() {
+    let db = Db::with("products", 7, "{\"name\":\"tea\"}");
+    assert_eq!(products::get(&db, 7).unwrap(), "{\"name\":\"tea\"}");
+}
+
+#[test]
+fn get_missing_product_is_404() {
+    assert!(products::get(&Db::in_memory(), 9).is_none());
+}
