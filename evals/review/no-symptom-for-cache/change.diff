+++ b/src/products.rs
@@ -0,0 +1,18 @@
+use crate::db::Db;
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+static CACHE: Mutex<Option<HashMap<u64, String>>> = Mutex::new(None);
+
+/// Returns the product as JSON, or `None` for a missing one.
+pub fn get(db: &Db, id: u64) -> Option<String> {
+    let mut guard = CACHE.lock().unwrap();
+    let cache = guard.get_or_insert_with(HashMap::new);
+    if let Some(hit) = cache.get(&id) {
+        return Some(hit.clone());
+    }
+    let product = db.find("products", id)?;
+    cache.insert(id, product.clone());
+    Some(product)
+}
diff --git a/tests/products.rs b/tests/products.rs
