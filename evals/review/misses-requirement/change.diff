--- /dev/null
+++ b/tests/count.rs
@@ -0,0 +1,12 @@
+use assert_cmd::Command;
+
+#[test]
+fn count_prints_the_lines() {
+    let dir = tempfile::tempdir().unwrap();
+    let file = dir.path().join("a.txt");
+    std::fs::write(&file, "one\ntwo\n").unwrap();
+    Command::cargo_bin("tally")
+        .unwrap()
+        .args(["count", file.to_str().unwrap()])
+        .assert()
+        .success()
+        .stdout("2\n");
+}
