diff --git a/src/count.rs b/src/count.rs
new file mode 100644
--- /dev/null
+++ b/src/count.rs
@@ -0,0 +1,12 @@
+use std::path::Path;
+
+/// Prints the lines of `file` and returns the exit code.
+pub fn run(file: &Path) -> i32 {
+    match std::fs::read_to_string(file) {
+        Ok(text) => {
+            println!("{}", text.lines().count());
+            0
+        }
+        Err(e) => {
+            eprintln!("{}: {e}", file.display());
+            1
+        }
+    }
+}
