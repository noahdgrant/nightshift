+/// Prints a greeting and returns the exit code.
+pub fn run(name: &str) -> i32 {
+    println!("Hello, {name}!");
+    0
+}
diff --git a/tests/greet.rs b/tests/greet.rs
new file mode 100644
--- /dev/null
+++ b/tests/greet.rs
@@ -0,0 +1,23 @@
+use assert_cmd::Command;
+use predicates::str::contains;
+
+#[test]
+fn greet_prints_the_name() {
+    Command::cargo_bin("tally")
+        .unwrap()
+        .args(["greet", "Ada"])
+        .assert()
+        .success()
+        .stdout("Hello, Ada!\n");
+}
+
+#[test]
+fn greet_without_a_name_is_a_usage_error() {
+    Command::cargo_bin("tally")
+        .unwrap()
+        .arg("greet")
+        .assert()
+        .code(2)
+        .stdout("")
+        .stderr(contains("Usage: tally greet <NAME>"));
+}
