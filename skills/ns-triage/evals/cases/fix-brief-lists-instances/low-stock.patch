             for item in self.items()
         ]
 
+    def low_stock(self, now: datetime, threshold: int) -> list[str]:
+        """SKUs with fewer than `threshold` available at `now`, in SKU order."""
+        held: dict[str, int] = defaultdict(int)
+        for r in self._reservations.values():
+            held[r.sku] += r.quantity
+        return [
+            item.sku
+            for item in self.items()
+            if self._on_hand[item.sku] - held[item.sku] < threshold
+        ]
+
