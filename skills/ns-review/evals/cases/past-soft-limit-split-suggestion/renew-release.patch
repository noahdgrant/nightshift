diff --git a/tests/test_renew_release.py b/tests/test_renew_release.py
new file mode 100644
index 0000000..5e50c07
--- /dev/null
+++ b/tests/test_renew_release.py
@@ -0,0 +1,90 @@
+from datetime import timedelta
+
+import pytest
+
+from inventory import ReservationExpired, UnknownReservation
+from inventory.cli import main
+
+from conftest import T0
+
+TTL = timedelta(minutes=30)
+
+
+def test_renew_moves_expiry_from_now(warehouse):
+    r = warehouse.reserve("BOLT-M6", 2, now=T0, ttl=TTL)
+    renewed = warehouse.renew(r.id, T0 + timedelta(minutes=10), TTL)
+    assert renewed.expires_at == T0 + timedelta(minutes=40)
+    assert warehouse.reservation(r.id) == renewed
+
+
+def test_renew_refuses_a_reservation_expired_at_now(warehouse):
+    r = warehouse.reserve("BOLT-M6", 2, now=T0, ttl=TTL)
+    with pytest.raises(ReservationExpired):
+        warehouse.renew(r.id, T0 + TTL, TTL)
+
+
+def test_renew_refuses_an_unknown_id(warehouse):
+    with pytest.raises(UnknownReservation):
+        warehouse.renew("R9999", T0, TTL)
+
+
+@pytest.mark.parametrize("ttl", [timedelta(0), timedelta(minutes=-1)])
+def test_renew_refuses_a_non_positive_ttl(warehouse, ttl):
+    r = warehouse.reserve("BOLT-M6", 2, now=T0, ttl=TTL)
+    with pytest.raises(ValueError):
+        warehouse.renew(r.id, T0, ttl)
+
+
+def test_release_expired_drops_expired_in_id_order(warehouse):
+    a = warehouse.reserve("BOLT-M6", 1, now=T0, ttl=timedelta(minutes=5))
+    live = warehouse.reserve("BOLT-M6", 1, now=T0, ttl=TTL)
+    b = warehouse.reserve("BOLT-M6", 1, now=T0, ttl=timedelta(minutes=5))
+    released = warehouse.release_expired(T0 + timedelta(minutes=5))
+    assert released == [a, b]
+    assert warehouse.reservations() == [live]
+
+
+def test_release_expired_with_nothing_expired(warehouse):
+    r = warehouse.reserve("BOLT-M6", 1, now=T0, ttl=TTL)
+    assert warehouse.release_expired(T0) == []
+    assert warehouse.reservations() == [r]
+
+
+@pytest.fixture
+def inv(tmp_path):
+    state = tmp_path / "inventory.json"
+
+    def run(*args: str, now: str = "2026-03-02T09:00:00") -> int:
+        return main(["--state", str(state), "--now", now, *args])
+
+    run("add-item", "BOLT-M6", "M6 hex bolt")
+    run("receive", "BOLT-M6", "10")
+    return run
+
+
+def test_cli_renew_prints_and_saves(inv, capsys):
+    inv("reserve", "BOLT-M6", "2", "--ttl", "15")
+    capsys.readouterr()
+    assert inv("renew", "R0001", now="2026-03-02T09:10:00") == 0
+    assert capsys.readouterr().out.strip() == "R0001: renewed until 2026-03-02T09:40:00"
+    assert inv("renew", "R0001", "--ttl", "5", now="2026-03-02T09:39:00") == 0
+    assert capsys.readouterr().out.strip() == "R0001: renewed until 2026-03-02T09:44:00"
+
+
+def test_cli_renew_errors_exit_non_zero(inv, capsys):
+    inv("reserve", "BOLT-M6", "2", "--ttl", "15")
+    capsys.readouterr()
+    assert inv("renew", "R9999") == 1
+    assert "R9999" in capsys.readouterr().err
+    assert inv("renew", "R0001", now="2026-03-02T09:15:00") == 1
+    assert "R0001" in capsys.readouterr().err
+
+
+def test_cli_release_expired_prints_and_saves(inv, capsys):
+    inv("reserve", "BOLT-M6", "1", "--ttl", "5")
+    inv("reserve", "BOLT-M6", "1", "--ttl", "60")
+    capsys.readouterr()
+    assert inv("release-expired", now="2026-03-02T09:05:00") == 0
+    assert capsys.readouterr().out.splitlines() == ["released R0001"]
+    assert inv("release-expired", now="2026-03-02T09:05:00") == 0
+    assert capsys.readouterr().out == ""
