+    def renew(self, reservation_id: str, now: datetime, ttl: timedelta) -> Reservation:
+        """Hold a live reservation until `now + ttl` instead of its old expiry."""
+        if ttl <= timedelta(0):
+            raise ValueError("ttl must be positive")
+        reservation = self.reservation(reservation_id)
+        if reservation.is_expired(now):
+            raise ReservationExpired(reservation_id)
+        renewed = replace(reservation, expires_at=now + ttl)
+        self._reservations[reservation_id] = renewed
+        return renewed
+
+    def release_expired(self, now: datetime) -> list[Reservation]:
+        """Drop every reservation expired at `now`, returning them in ID order."""
+        expired = [r for r in self.reservations() if r.is_expired(now)]
+        for r in expired:
+            del self._reservations[r.id]
+        return expired
+
