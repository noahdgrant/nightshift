+def test_reserve_rejects_ttl_over_one_day(warehouse):
+    with pytest.raises(ValueError):
+        warehouse.reserve("BOLT-M6", 1, now=T0, ttl=timedelta(days=1, seconds=1))
+    assert warehouse.reservations("BOLT-M6") == []
+
+
+def test_reserve_accepts_ttl_of_exactly_one_day(warehouse):
+    r = warehouse.reserve("BOLT-M6", 1, now=T0, ttl=timedelta(days=1))
+    assert r.expires_at == T0 + timedelta(days=1)
