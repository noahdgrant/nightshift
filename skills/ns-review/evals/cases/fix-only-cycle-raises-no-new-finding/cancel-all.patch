diff --git a/src/inventory/warehouse.py b/src/inventory/warehouse.py
index da52c45..67226e9 100644
--- a/src/inventory/warehouse.py
+++ b/src/inventory/warehouse.py
@@ -113,6 +113,15 @@ class Warehouse:
         del self._reservations[reservation_id]
         return reservation
 
+    def cancel_all(self, sku: str) -> int:
+        """Drop every reservation of `sku`, returning how many were dropped."""
+        self.item(sku)
+        doomed = [rid for rid, r in self._reservations.items() if r.sku == sku]
+        for rid in doomed:
+            del self._reservations[rid]
+        print(f"cancel_all {sku}: dropped {len(doomed)}")
+        return len(doomed)
+
     def fulfil(self, reservation_id: str, now: datetime) -> Reservation:
         """Ship a reservation: remove its quantity from stock on hand."""
         reservation = self.reservation(reservation_id)
