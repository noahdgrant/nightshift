+
+
+def test_cancel_all_drops_only_that_sku(warehouse):
+    warehouse.reserve("BOLT-M6", 2, now=T0)
+    warehouse.reserve("BOLT-M6", 3, now=T0)
+    warehouse.receive("NUT-M6", 5)
+    kept = warehouse.reserve("NUT-M6", 1, now=T0)
+    assert warehouse.cancel_all("BOLT-M6") == 2
+    assert warehouse.reservations("BOLT-M6") == []
+    assert warehouse.reservations("NUT-M6") == [kept]
+
+
+def test_cancel_all_with_no_reservations_drops_none(warehouse):
+    assert warehouse.cancel_all("BOLT-M6") == 0
