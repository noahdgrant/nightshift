+// A reservation as the dashboard shows it.
+export interface ReservationView {
+  id: string;
+  sku: string;
+  quantity: number;
+  heldUntil?: string;
+  fulfilledAt?: string;
+  cancelledAt?: string;
+  cancelReason?: string;
+}
+
+export function statusLabel(r: ReservationView): string {
+  if (r.cancelledAt) {
+    return `cancelled ${r.cancelledAt}: ${r.cancelReason}`;
+  }
+  if (r.fulfilledAt) {
+    return `fulfilled ${r.fulfilledAt}`;
+  }
+  return `held until ${r.heldUntil}`;
+}
