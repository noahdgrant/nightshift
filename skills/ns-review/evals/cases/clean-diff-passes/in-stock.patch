+def test_in_stock_while_one_unit_is_left(warehouse):
+    warehouse.reserve("BOLT-M6", 9, now=T0)
+    assert warehouse.available("BOLT-M6", T0) == 1
+    assert warehouse.in_stock("BOLT-M6", T0)
+
