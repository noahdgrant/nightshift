diff --git a/tests/test_cli_status_json.py b/tests/test_cli_status_json.py
new file mode 100644
index 0000000..5de8727
--- /dev/null
+++ b/tests/test_cli_status_json.py
@@ -0,0 +1,52 @@
+import json
+
+import pytest
+
+from inventory.cli import main
+
+
+@pytest.fixture
+def inv(tmp_path):
+    state = tmp_path / "inventory.json"
+
+    def run(*args: str) -> int:
+        return main(["--state", str(state), "--now", "2026-03-02T09:00:00", *args])
+
+    return run
+
+
+def stock(inv, capsys):
+    inv("add-item", "NUT-M6", "M6 hex nut")
+    inv("add-item", "BOLT-M6", "M6 hex bolt")
+    inv("receive", "NUT-M6", "3")
+    capsys.readouterr()
+
+
+def test_status_json_lists_every_item_in_sku_order(inv, capsys):
+    inv("add-item", "NUT-M6", "M6 hex nut")
+    inv("add-item", "BOLT-M6", "M6 hex bolt")
+    inv("receive", "BOLT-M6", "10")
+    inv("receive", "NUT-M6", "3")
+    inv("reserve", "BOLT-M6", "4")
+    capsys.readouterr()
+    assert inv("status", "--json") == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"sku": "BOLT-M6", "on_hand": 10, "reserved": 4, "available": 6},
+        {"sku": "NUT-M6", "on_hand": 3, "reserved": 0, "available": 3},
+    ]
+
+
+def test_status_json_for_one_sku(inv, capsys):
+    stock(inv, capsys)
+    assert inv("status", "--json", "NUT-M6") == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"sku": "NUT-M6", "on_hand": 3, "reserved": 0, "available": 3},
+    ]
+
+
+def test_status_json_for_unknown_sku_fails(inv, capsys):
+    stock(inv, capsys)
+    assert inv("status", "--json", "SCREW-M3") == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.strip() == "inventory: error: unknown item 'SCREW-M3'"
