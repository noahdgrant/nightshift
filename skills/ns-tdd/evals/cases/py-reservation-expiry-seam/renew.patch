 from __future__ import annotations
 
 from collections import defaultdict
+from dataclasses import replace
 from datetime import datetime, timedelta
 
 from inventory.errors import (
@@ -113,6 +114,18 @@ class Warehouse:
         del self._reservations[reservation_id]
         return reservation
 
+    def renew(self, reservation_id: str, ttl: timedelta = DEFAULT_TTL) -> Reservation:
+        """Extend an unexpired reservation so it holds for `ttl` from now."""
+        if ttl <= timedelta(0):
+            raise ValueError("ttl must be positive")
+        reservation = self.reservation(reservation_id)
+        now = datetime.now()
+        if reservation.is_expired(now):
+            raise ReservationExpired(reservation_id)
+        renewed = replace(reservation, expires_at=now + ttl)
+        self._reservations[reservation_id] = renewed
+        return renewed
+
     def fulfil(self, reservation_id: str, now: datetime) -> Reservation:
         """Ship a reservation: remove its quantity from stock on hand."""
         reservation = self.reservation(reservation_id)
